# Copie estes nomes para Vercel > Project > Settings > Environment Variables.
# Nunca coloque os valores reais no GitHub nem no chat.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel do dono no primeiro acesso (mínimo 8 caracteres, invente uma forte).
# Vale para /barbearia/painel e /lavarapido/painel. Depois de entrar, dá para trocar no próprio painel.
PAINEL_SENHA=

# WhatsApp (Meta for Developers > seu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma palavra qualquer que você inventa; a mesma vai no campo "Verify token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > seu app > App settings > Basic > App secret. Garante que só a Meta fala com o robô.
WHATSAPP_APP_SECRET=

# Opcionais. Se ficarem em branco, o site gera essas senhas sozinho.
SESSION_SECRET=
CRON_SECRET=

# Endereço do site depois de publicado, sem barra no final (ex.: https://agendamento.vercel.app)
SITE_URL=
